# Next.js dev server가 백엔드 API로 프록시할 주소 (next.config rewrites)
BACKEND_API_ORIGIN=http://localhost:8080

# API 클라이언트 기본 URL (lib/api-config.ts, lib/api/config.ts)
NEXT_PUBLIC_API_URL=http://localhost:8080

# false 로 설정해야 실제 백엔드 API 사용 (기본값은 mock)
NEXT_PUBLIC_USE_MOCK_API=false

# false 로 설정해야 업로드 전용 화면이 아닌 전체 기능을 사용
NEXT_PUBLIC_UPLOAD_ONLY_MODE=false

# false면 새로고침·URL 직접 접속 시 자동 로그인하지 않음
# 백엔드 AUTH_REFRESH_ENABLED와 동일한 값으로 설정
NEXT_PUBLIC_AUTH_REFRESH_ENABLED=false
